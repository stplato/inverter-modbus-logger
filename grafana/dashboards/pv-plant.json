                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "AC / DC power and power limit (kW)",
      "description": "Flat top at 100 kW = clipping. Flat top below 100 kW with the limit line = curtailment.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pv-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pv-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time AS \"time\",\n       ac_kw AS \"AC power\",\n       dc_kw AS \"DC power\",\n       CASE WHEN limit_enabled THEN limit_pct ELSE 100 END AS \"Power limit\"\nFROM readings\nWHERE $__timeFilter(time) AND quality = 'GOOD'\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "AC power"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "DC power"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Power limit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Temperatures (°C)",
      "description": "HIGH_TEMP alarm: raised above 70 °C for 3 polls, cleared below 65 °C (hysteresis)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pv-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pv-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time AS \"time\", t_heatsink_c AS \"Heatsink\", t_cabinet_c AS \"Cabinet\"\nFROM readings\nWHERE $__timeFilter(time) AND quality = 'GOOD'\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#ff990022",
                "value": 65
              },
              {
                "color": "#ff000033",
                "value": 70
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "state-timeline",
      "title": "Inverter state over time",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pv-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pv-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time AS \"time\", coalesce(state, 'COMMS_LOST') AS \"State\"\nFROM readings WHERE $__timeFilter(time) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "MPPT": {
                  "color": "green",
                  "index": 0
                },
                "THROTTLED": {
                  "color": "yellow",
                  "index": 1
                },
                "SLEEPING": {
                  "color": "#6e7681",
                  "index": 2
                },
                "STARTING": {
                  "color": "blue",
                  "index": 3
                },
                "FAULT": {
                  "color": "red",
                  "index": 4
                },
                "COMMS_LOST": {
                  "color": "purple",
                  "index": 5
                },
                "OFF": {
                  "color": "#6e7681",
                  "index": 6
                },
                "STANDBY": {
                  "color": "blue",
                  "index": 7
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Alarms",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pv-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pv-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.started_at AS \"Started\", a.cleared_at AS \"Cleared\",\n       d.name AS \"Device\", a.code AS \"Alarm\", a.severity AS \"Severity\",\n       CASE WHEN a.cleared_at IS NULL THEN 'ACTIVE' ELSE 'cleared' END AS \"Status\",\n       to_char(coalesce(a.cleared_at, now()) - a.started_at, 'HH24:MI:SS') AS \"Duration\",\n       a.message AS \"Message\"\nFROM alarms a JOIN devices d USING (device_id)\nWHERE a.started_at <= $__timeTo() AND coalesce(a.cleared_at, now()) >= $__timeFrom()\nORDER BY a.started_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "CRITICAL": {
                        "color": "red",
                        "index": 0
                      },
                      "WARNING": {
                        "color": "orange",
                        "index": 1
                      },
                      "INFO": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ACTIVE": {
                        "color": "red",
                        "index": 0
                      },
                      "cleared": {
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}