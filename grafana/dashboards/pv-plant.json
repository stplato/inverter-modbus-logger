{
  "uid": "pv-plant",
  "title": "PV Plant - Athens 100 kW (simulated)",
  "description": "Project 1 - SunSpec inverter simulator + Modbus logger + PostgreSQL historian",
  "tags": [
    "pv",
    "scada",
    "sunspec"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "2026-04-16T03:00:00.000Z",
    "to": "2026-04-16T19:00:00.000Z"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Energy (selected period)",
      "description": "Sum of positive energy-counter differences (LAG) - robust to counter resets",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pv-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pv-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH d AS (\n  SELECT energy_kwh - LAG(energy_kwh) OVER (PARTITION BY device_id ORDER BY time) AS delta\n  FROM readings WHERE $__timeFilter(time) AND quality = 'GOOD'\n)\nSELECT coalesce(sum(delta) FILTER (WHERE delta > 0), 0) AS \"Energy\" FROM d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Specific yield",
      "description": "kWh per kWp installed (120 kWp). Sanity check: > 8 per day is physically impossible",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pv-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pv-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH d AS (\n  SELECT energy_kwh - LAG(energy_kwh) OVER (PARTITION BY device_id ORDER BY time) AS delta\n  FROM readings WHERE $__timeFilter(time) AND quality = 'GOOD'\n)\nSELECT coalesce(sum(delta) FILTER (WHERE delta > 0), 0) / 120.0 AS \"Specific yield\" FROM d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Peak AC power",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pv-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pv-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT max(ac_kw) AS \"Peak power\" FROM readings\nWHERE $__timeFilter(time) AND quality = 'GOOD'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Data availability",
      "description": "Share of polls that returned GOOD data (not plant availability!)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pv-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pv-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE quality = 'GOOD') / nullif(count(*), 0) AS \"Data availability\"\nFROM readings WHERE $__timeFilter(time)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Inverter state (latest)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pv-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pv-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(state, 'COMMS_LOST') AS \"State\" FROM readings\nWHERE $__timeFilter(time) ORDER BY time DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "MPPT": {
                  "color": "green",
                  "index": 0
                },
                "THROTTLED": {
                  "color": "yellow",
                  "index": 1
                },
                "SLEEPING": {
                  "color": "#6e7681",
                  "index": 2
                },
                "STARTING": {
                  "color": "blue",
                  "index": 3
                },
                "FAULT": {
                  "color": "red",
                  "index": 4
                },
                "COMMS_LOST": {
                  "color": "purple",
                  "index": 5
                },
                "OFF": {
                  "color": "#6e7681",
                  "index": 6
                },
                "STANDBY": {
                  "color": "blue",
                  "index": 7
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^State$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Active alarms",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pv-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
